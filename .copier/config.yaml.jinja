# Application configuration.
# Plain values are used directly as defaults.
# $VAR placeholders declare secret keys that must be provided via env/.env;
# see .env-example for the required variables.
#
# Any value here can be overridden at runtime by setting the corresponding
# env var with __ separator (e.g. APP__DEBUG=true).
# Precedence: init > env > dotenv > yaml

app:
  name: "{{ project_name }}"
  version: "0.1.0"
  debug: false
  host: "0.0.0.0"
  port: 8000
  timezone: 8

log:
  level: INFO
  json_logs: false

db:
  driver: {{ development_database }}
{% if development_database == 'sqlite' %}
  database: "{{ sqlite_db_path }}"
{% else %}
  host: "{{ postgresql_host }}"
  port: {{ postgresql_port }}
  user: "{{ postgresql_user }}"
  password: $DB__PASSWORD
  database: "{{ postgresql_dbname }}"
{% endif %}
  echo: false

cache:
  backend: {{ cache_backend }}
{% if cache_backend == 'redis' %}
  host: "{{ cache_host }}"
  port: {{ cache_port }}
  db: {{ cache_db }}
  password: $CACHE__PASSWORD
{% endif %}
  encoding: utf-8
  decode_responses: true
  socket_timeout: 5
  socket_connect_timeout: 5
  max_connections: 50
  retry_on_timeout: true

auth:
  jwt_secret: $AUTH__JWT_SECRET
  jwt_algorithm: HS256
  jwt_lifetime_seconds: 1800
  refresh_token_lifetime_seconds: 2592000
{% if 'google' in oauth_providers %}
  oauth_google_client_id: "{{ google_oauth_client_id }}"
  oauth_google_client_secret: $AUTH__OAUTH_GOOGLE_CLIENT_SECRET
{% else %}
  oauth_google_client_id: null
  oauth_google_client_secret: null
{% endif %}
{% if 'github' in oauth_providers %}
  oauth_github_client_id: "{{ github_oauth_client_id }}"
  oauth_github_client_secret: $AUTH__OAUTH_GITHUB_CLIENT_SECRET
{% else %}
  oauth_github_client_id: null
  oauth_github_client_secret: null
{% endif %}
