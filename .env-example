APP__NAME=Test App
APP__VERSION=1.0.0
APP__DEBUG=true
APP__HOST=127.0.0.1
APP__PORT=9000

DB__DRIVER=sqlite
DB__DATABASE=./test.db
# DB__DRIVER=postgresql
# DB__HOST=localhost
# DB__PORT=5432
# DB__USER=postgres
# DB__PASSWORD=postgres
# DB__DATABASE=app_db

CACHE__BACKEND=redis
CACHE__HOST=localhost
CACHE__PORT=6379
CACHE__DB=1
CACHE__PASSWORD=password
CACHE__ENCODING=utf-8

AUTH__JWT_SECRET_KEY=your-secret-key-here
AUTH__JWT_ALGORITHM=HS256
AUTH__JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH__JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# 向后兼容字段
AUTH__JWT_LIFETIME_SECONDS=1800
AUTH__REFRESH_TOKEN_LIFETIME_SECONDS=2592000

AUTH__OAUTH_GOOGLE_CLIENT_ID=
AUTH__OAUTH_GOOGLE_CLIENT_SECRET=
AUTH__OAUTH_GITHUB_CLIENT_ID=
AUTH__OAUTH_GITHUB_CLIENT_SECRET=