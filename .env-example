### Bootstrap configuration for the application.
# If left blank, no yaml file will be loaded.
APP_CONFIG_FILE=config.yaml

### Secrets — required
# These MUST be set for the application to function.
# They correspond to $VAR placeholders in config.yaml.
# Do not commit real secrets to git.
AUTH__JWT_SECRET=your-super-super-long-secret-key-here
DB__PASSWORD=postgres

### Secrets — optional
# Only needed when enabling the corresponding feature.
# Leave blank if not using the feature; defaults to null/None.
CACHE__PASSWORD=
AUTH__OAUTH_GOOGLE_CLIENT_SECRET=
AUTH__OAUTH_GITHUB_CLIENT_SECRET=

### Runtime overrides — optional
# All values below have defaults defined in config.yaml.
# Uncomment and modify to override per deployment environment.
# Precedence: init > env > dotenv > yaml
# APP__DEBUG=true